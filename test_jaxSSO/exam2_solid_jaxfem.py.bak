# -*- coding: utf-8 -*-
"""
[WHT_LightChassisModel] Exam 2: 3D Solid Hexa Modal Analysis using jax-fem
==========================================================================
1. Geometry: 3D Hexahedral Shell Tray (Gmsh)
2. Data Model: WHTMeshModel (is_solid=True)
3. Solver: jax-fem (Modal)
4. Pipeline: JaxFEMAdapter -> VTKHDFExporter (ParaView)
"""

import os
import sys
import math
from pathlib import Path
import numpy as np
import jax
import jax.numpy as jnp
import pyvista as pv

# jax-fem components
from jax_fem.problem import Problem
from jax_fem.generate_mesh import Mesh

# Project components
# Add project root to path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from test_jaxSSO.mesh_utils import generate_solid_hexa_tray
from wht_modeler.wht_mesh_model import WHTMeshModel
from wht_converter.wht_adapters import JaxFEMAdapter
from wht_converter.wht_models import WHTMetadata
from wht_converter.wht_exporters import VTKHDFExporter, VTUPVDExporter
from wht_visualizer.wht_visualizer import WHTVisualizer

def run_exam2():
    print("\n" + "="*60)
    print(" [Exam 2] Solid Modal Analysis Pipeline (jax-fem)")
    print("="*60 + "\n")
    
    # 1. Geometry conditions
    width, length, height = 1800.0, 1200.0, 10.0
    thickness = 0.6
    mesh_size_xy = 80.0 
    draft_angle = 15.0
    flange_width = 1.0
    mesh_size_z = 3.0
    
    # 2. Generate Solid Hexa Mesh (Order 2 = HEX27)
    print(f" -> Generating 2nd-Order Solid Hexa Tray Mesh (T={thickness}, Order=2)...")
    node_db, elem_db = generate_solid_hexa_tray(
        width=width, length=length, height=height, thickness=thickness,   
        mesh_size_xy=mesh_size_xy, mesh_size_z=mesh_size_z, draft_angle=draft_angle, 
        wall_layers=1, flange_width=flange_width, origin='center', order=2
    )
    
    # 3. Build WHTMeshModel
    model = WHTMeshModel.from_node_elem_db(node_db, elem_db, name="HexaTray", is_solid=True)
    print(f"    Nodes: {model.n_nodes}, Elements: {model.n_elements}")

    try:
        import jax.numpy as jnp
        import jax
        from jax_fem.generate_mesh import Mesh
        from jax_fem.problem import Problem
        from scipy.sparse.linalg import eigsh
        from scipy.sparse import diags
    except ImportError as e:
        print(f"[!] ImportError encountered: {e}\n    Exiting pipeline.")
        return

    print(" -> Building jax-fem Problem (HEX27)...")
    points = np.array([node_db[nid] for nid in sorted(node_db.keys())], dtype=np.float64)
    cells  = np.array([elem_db[eid] for eid in sorted(elem_db.keys())], dtype=np.int64)
    
    print(f"    [DEBUG] Points shape: {points.shape}, dtype: {points.dtype}")
    print(f"    [DEBUG] Cells shape: {cells.shape}, dtype: {cells.dtype}")
    if len(cells) > 0:
        print(f"    [DEBUG] First element node count: {len(cells[0])}")
    else:
        print("    [DEBUG] ERROR: Cells array is EMPTY!")
    
    mesh = Mesh(cells=cells, points=points, ele_type='HEX27')
    
    # 5. jax-fem Modal Analysis Setup
    E, nu, rho = 210.0e3, 0.3, 7.85e-9 # Consistent units (MPa, ton, mm)

    class HexaModalProblem(Problem):
        def get_tensor_map(self):
            def constitutive_equation(u_grad):
                mu = E / (2.0 * (1.0 + nu))
                lmbda = E * nu / ((1.0 + nu) * (1.0 - 2.0 * nu))
                epsilon = 0.5 * (u_grad + u_grad.T)
                return lmbda * jnp.trace(epsilon) * jnp.eye(3) + 2.0 * mu * epsilon
            return constitutive_equation

    # --- BOUNDARY CONDITIONS (Fixed Base) ---
    # BC: Fix Top Flange (Z = height)
    print(f" -> Applying Dirichlet BC at Z = {height} (Top Flange)...")
    def base_boundary(point):
        return jnp.abs(point[2] - height) < 1e-3
    
    fixed_nodes = [i for i, p in enumerate(points) if base_boundary(p)]
    print(f"    Total Fixed Nodes found: {len(fixed_nodes)}")

    # location_fns, vecs (component Indices), value_fns
    # jax-fem expects each component to have its own location and value function
    dirichlet_bc_info = [
        [base_boundary, base_boundary, base_boundary], 
        [0, 1, 2], 
        [lambda x: 0.0, lambda x: 0.0, lambda x: 0.0]
    ]

    print(" -> Assembling Stiffness Matrix (jax-fem, HEX27)...")
    problem = HexaModalProblem(mesh, vec=3, dim=3, ele_type='HEX27', dirichlet_bc_info=dirichlet_bc_info)
    
    # Assemble K via Newton Update (Tangent at zero state)
    dofs_zero = np.zeros(problem.num_total_dofs_all_vars)
    sol_list = problem.unflatten_fn_sol_list(dofs_zero)
    problem.newton_update(sol_list)
    
    import scipy.sparse as sps
    K = sps.csr_matrix((np.array(problem.V), (problem.I, problem.J)), 
                       shape=(problem.num_total_dofs_all_vars, problem.num_total_dofs_all_vars))
    
    # Accurate volume-based lumped mass matrix (HEX27)
    nodal_mass = np.zeros(len(points))
    
    print(" -> Calculating element volumes manually...")
    for i, cell in enumerate(cells):
        # We only need the 8 corner nodes (0-7) to approximate the volume of the hexahedron
        # For our extruded tray, we take the average area of bottom/top face and multiply by height
        c = [points[cell[j]] for j in range(8)]
        
        # Bottom face: nodes 0, 1, 2, 3
        # Top face: nodes 4, 5, 6, 7
        def get_area(p):
            # Shoe-lace formula for 2D area (projection on XY if wall, or general)
            # Since our mesh is mostly axis-aligned or extruded along Z:
            # We use the full 3D triangle-based area for robustness
            def tri_area(v1, v2, v3):
                return 0.5 * np.linalg.norm(np.cross(v2 - v1, v3 - v1))
            return tri_area(p[0], p[1], p[2]) + tri_area(p[0], p[2], p[3])
            
        area_bot = get_area(c[0:4])
        area_top = get_area(c[4:8])
        avg_area = 0.5 * (area_bot + area_top)
        
        # Height is distance between bottom and top face centers
        center_bot = np.mean(c[0:4], axis=0)
        center_top = np.mean(c[4:8], axis=0)
        h = np.linalg.norm(center_top - center_bot)
        
        v_cell = avg_area * h
        m_cell = v_cell * rho
        nodal_mass[cell] += m_cell / 27.0
    
    dof_mass = np.repeat(nodal_mass, 3)
    from scipy.sparse import diags
    M = diags([dof_mass], [0], shape=(K.shape[0], K.shape[0]), dtype=K.dtype).tocsr()
    print(f" -> [Sanity Check] Total Solid Mass from M: {np.sum(nodal_mass):.6f} tons")

    # Solve Eigenvalues
    fixed_dofs = []
    for node_idx in fixed_nodes:
        fixed_dofs.extend([node_idx*3, node_idx*3 + 1, node_idx*3 + 2])
    
    all_dofs = np.arange(K.shape[0])
    free_dofs = np.setdiff1d(all_dofs, fixed_dofs)
    
    K_free = K[free_dofs, :][:, free_dofs]
    M_free = M[free_dofs, :][:, free_dofs]
    
    print(f" -> Condensed System: {len(free_dofs)} DOFs (from {K.shape[0]})")

    # Solve Eigenvalues on condensed system
    num_modes = 16
    print(f" -> Solving for {num_modes} Natural Frequencies (Condensed System)...", flush=True)
    try:
        from scipy.sparse.linalg import lobpcg
        # LOBPCG often converges better for large structural problems
        # Needs initial guess
        X = np.random.normal(size=(K_free.shape[0], num_modes))
        vals, vecs_free = lobpcg(K_free, X, B=M_free, largest=False, tol=1e-5, maxiter=200)
    except Exception as e:
        print(f" -> [Error] Eigenvalue solver failed: {e}", flush=True)
        return
    
    sorted_indices = np.argsort(vals)
    vals = vals[sorted_indices]
    vecs_free = vecs_free[:, sorted_indices]
    
    # Reconstruct full mode shapes (Zero for fixed DOFs)
    vecs_full = np.zeros((K.shape[0], num_modes))
    vecs_full[free_dofs, :] = vecs_free
    
    # --- Normalize Mode Shapes (Max Displacement = 1.0) ---
    for m in range(num_modes):
        max_disp = np.max(np.abs(vecs_full[:, m]))
        if max_disp > 1e-12:
            vecs_full[:, m] /= max_disp
    
    # Hz Calculation
    freqs = np.sqrt(np.abs(vals)) / (2.0 * np.pi)
    print("\n[Solid Result] Natural Frequencies (Hz):")
    for i, f in enumerate(freqs):
        print(f"  Mode {i+1}: {f:8.2f} Hz")
    
    # Format results for Adapter
    vecs_reshaped = vecs_full.reshape((len(points), 3, num_modes)).transpose(2, 0, 1)
    results = {"eigvecs": vecs_reshaped, "eigvals": vals}

    # 6. Conversion & Export
    adapter = JaxFEMAdapter()
    meta = WHTMetadata(solver_name="jax-fem", solver_version="0.1.0", analysis_type="modal", 
                        coordinate_system="cartesian", unit_length="mm", unit_force="N")
    wht_data = adapter.convert(problem, results, "modal", meta)
    
    # Visualization and export paths...
    import datetime
    stamp = datetime.datetime.now().strftime("D%Y%m%d-%H%M%S")
    out_dir = Path(__file__).resolve().parent.parent / "results" / stamp
    out_dir.mkdir(parents=True, exist_ok=True)
    VTKHDFExporter().export(wht_data, str(out_dir/"solid_hexa_modal.hdf"))
    
    # 7. Visualization
    print(" -> Launching WHT Visualizer...")
    viz = WHTVisualizer(title="Solid Hexa Modal Analysis (Fixed)", show=True)
    viz.load_results(wht_data, color="black", label="Solid Hexa Modal Shape")
    viz.plotter.view_isometric()
    viz.plotter.reset_camera()
    
    if hasattr(viz.plotter, 'app'):
        viz.plotter.app.exec_()
    print(" -> Pipeline Completed Successfully!")

if __name__ == "__main__":
    run_exam2()